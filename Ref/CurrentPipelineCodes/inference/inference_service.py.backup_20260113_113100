def image_writer_thread(queue_id, write_queue):
    """Background thread that writes frames from queue to disk.

    Args:
        queue_id: ID of this writer thread (0-3)
        write_queue: Queue to pull (frame, filename) tuples from
    """
    print(f"📝 Writer thread {queue_id} started")
    frames_written = 0

    while True:
        try:
            item = write_queue.get(timeout=1.0)

            if item is None:  # Poison pill to stop thread
                print(f"📝 Writer thread {queue_id} stopping (wrote {frames_written} frames)")
                break

            frame, filename = item

            try:
                # Write JPEG with high quality
                cv2.imwrite(filename, frame, [cv2.IMWRITE_JPEG_QUALITY, 95])
                frames_written += 1

            except Exception as e:
                print(f"❌ Writer thread {queue_id} - Failed to write {filename}: {e}")

        except queue.Empty:
            continue
        except Exception as e:
            print(f"❌ Writer thread {queue_id} error: {e}")


def metadata_writer_thread(output_folder):
    """Background thread that writes metadata CSV file.

    Writes: frame_id, timestamp_unix, timestamp_str, filename
    """
    csv_path = Path(output_folder) / "frame_metadata.csv"
    print(f"📊 Metadata writer started: {csv_path}")

    try:
        with open(csv_path, 'w', newline='') as csvfile:
            writer = csv.writer(csvfile)
            writer.writerow(['frame_id', 'timestamp_unix', 'timestamp_iso', 'filename'])

            while True:
                try:
                    item = metadata_queue.get(timeout=1.0)

                    if item is None:  # Poison pill
                        print(f"📊 Metadata writer stopping")
                        break

                    frame_id, timestamp_unix, timestamp_str, filename = item
                    writer.writerow([frame_id, f"{timestamp_unix:.6f}", timestamp_str, filename])
                    csvfile.flush()  # Ensure data is written immediately

                except queue.Empty:
                    continue

    except Exception as e:
        print(f"❌ Metadata writer error: {e}")
        import traceback
        traceback.print_exc()


def initialize_recording_threads(images_folder, dataset_folder):
    """Initialize writer threads and queues.

    Args:
        images_folder: Folder where images are saved (for writer threads)
        dataset_folder: Parent folder where metadata CSV is saved
    """
    global writer_queues, writer_threads, metadata_thread

    # Create queues for each writer thread
    writer_queues = [queue.Queue(maxsize=25) for _ in range(NUM_WRITER_THREADS)]

    # Start writer threads
    writer_threads = []
    for i, q in enumerate(writer_queues):
        thread = threading.Thread(target=image_writer_thread, args=(i, q), daemon=True)
        thread.start()
        writer_threads.append(thread)

    # Start metadata writer thread (writes to parent folder)
    metadata_thread = threading.Thread(target=metadata_writer_thread, args=(dataset_folder,), daemon=True)
    metadata_thread.start()

    print(f"✅ Initialized {NUM_WRITER_THREADS} writer threads + metadata thread")


def stop_recording_threads():
    """Stop all writer threads gracefully."""
    global writer_queues, writer_threads, metadata_thread

    # Send poison pills to all writer threads
    for q in writer_queues:
        q.put(None)

    # Send poison pill to metadata thread
    metadata_queue.put(None)

    # Wait for threads to finish
    for thread in writer_threads:
        thread.join(timeout=2.0)

    if metadata_thread:
        metadata_thread.join(timeout=2.0)

    writer_queues.clear()
    writer_threads.clear()
    metadata_thread = None

    print(f"✅ All writer threads stopped")



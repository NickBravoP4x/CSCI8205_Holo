                elif cmd == "recording_status":
                    # Return current recording status for polling
                    with recording_lock:
                        reply = {
                            "status": "ok",
                            "recording": recording,
                            "frames_recorded": recording_frame_counter,
                            "target_count": recording_target_count,
                            "complete": recording_frame_counter >= recording_target_count if recording else False
                        }
                    control_rep.send_json(reply)

                elif cmd == "get_detection_summary":
                    # Return detection counts by class (for Full Test results)
                    prefilter_total = prefilter_pass_count + prefilter_skip_count
                    reply = {
                        "status": "ok",
                        "detections": {
                            "total": total_detection_count,
                            "by_class": detection_counts_by_class.copy()
                        },
                        "prefilter": {
                            "enabled": prefilter_enabled,
                            "passed": prefilter_pass_count,
                            "skipped": prefilter_skip_count,
                            "total": prefilter_total,
                            "pass_rate": (prefilter_pass_count / prefilter_total * 100) if prefilter_total > 0 else 0.0
                        }
                    }
                    control_rep.send_json(reply)
                    print(f"📊 Detection summary: {total_detection_count} total, by class: {detection_counts_by_class}")
                    if prefilter_enabled:
                        print(f"   Prefilter: {prefilter_pass_count} passed, {prefilter_skip_count} skipped ({reply['prefilter']['pass_rate']:.1f}% pass rate)")

                elif cmd == "reset_detection_counts":
                    # Reset detection counts (called at start of Full Test)
                    detection_counts_by_class.clear()
                    total_detection_count = 0
                    prefilter_skip_count = 0
                    prefilter_pass_count = 0
                    control_rep.send_json({"status": "ok"})
                    print(f"🔄 Detection counts reset (including prefilter stats)")

                elif cmd == "process_folder":
                    # Post-process saved images: enhancement + detection + labels
                    folder = msg.get("folder")
                    proc_confidence = msg.get("conf", confidence_threshold)
                    run_enhancement = msg.get("enhancement", True)
                    save_enhanced = msg.get("save_enhanced", True)

                    print(f"\n{'='*60}")
                    print(f"📁 POST-PROCESSING FOLDER")
                    print(f"{'='*60}")
                    print(f"  Folder: {folder}")
                    print(f"  Enhancement: {run_enhancement}")
                    print(f"  Save enhanced: {save_enhanced}")
                    print(f"  Confidence: {proc_confidence}")

                    base_folder = Path(folder)
                    images_folder = base_folder / "images"
                    labels_folder = base_folder / "labels"
                    enhanced_folder = base_folder / "images_enhanced"

                    # Create enhanced folder if saving
                    if save_enhanced and run_enhancement:
                        enhanced_folder.mkdir(parents=True, exist_ok=True)

                    # Reset detection counts
                    detection_counts_by_class.clear()
                    total_detection_count = 0

                    # Get list of images
                    image_files = sorted(images_folder.glob("*.jpg"))
                    total_images = len(image_files)
                    print(f"  Found {total_images} images to process")
                    print(f"{'='*60}\n")

                    # Note: We process synchronously and send a single response
                    # Progress updates go via status_pub

                    # Create local enhancer for batch processing
                    batch_enhancer = MovingWindowEnhancer(window_size=20) if run_enhancement else None

                    # Process each image
                    for i, img_path in enumerate(image_files):
                        try:
                            # Load image
                            frame = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)
                            if frame is None:
                                print(f"⚠️ Failed to load: {img_path.name}")
                                continue

                            # Convert to tensor
                            tensor_img = torch.from_numpy(frame).float().cuda() / 255.0

                            # Enhancement (optional)
                            if run_enhancement and batch_enhancer is not None:
                                if save_enhanced:
                                    # Need uint8 for saving
                                    enhanced_tensor = batch_enhancer.enhance(tensor_img)
                                    enhanced_frame = enhanced_tensor.cpu().numpy()
                                    enhanced_path = enhanced_folder / img_path.name
                                    cv2.imwrite(str(enhanced_path), enhanced_frame)
                                    tensor_img = enhanced_tensor.float() / 255.0
                                else:
                                    # Skip uint8 conversion when not saving
                                    tensor_img = batch_enhancer.enhance(tensor_img, return_float=True)

                            # Detection (no reconstruction - use enhanced grayscale directly)
                            if model is not None:
                                img_h, img_w = tensor_img.shape

                                # Prepare for YOLO: grayscale to 3-channel
                                model_in = tensor_img.unsqueeze(0).unsqueeze(0)  # (1, 1, H, W)
                                model_in = model_in.expand(-1, 3, -1, -1)  # (1, 3, H, W)
                                try:
                                    model_input_size = model.model.args.get("imgsz", 640)
                                except (AttributeError, TypeError):
                                    model_input_size = 640  # Default for TensorRT
                                if isinstance(model_input_size, int):
                                    model_input_size = (model_input_size, model_input_size)

                                model_in = F.interpolate(
                                    model_in,
                                    size=model_input_size,
                                    mode="bilinear",
                                    align_corners=False
                                )

                                # Run inference (TensorRT handles FP16 internally)
                                with torch.no_grad():
                                    if using_tensorrt:
                                        result = model(model_in, conf=proc_confidence, verbose=False)[0]
                                    else:
                                        model_in_fp16 = model_in.half()
                                        result = model(model_in_fp16, conf=proc_confidence, verbose=False, device="cuda", half=True)[0]

                                # Process detections
                                boxes = result.boxes
                                if boxes is not None and boxes.data.numel() > 0:
                                    orig_h, orig_w = frame.shape[:2]
                                    model_h, model_w = model_input_size

                                    current_boxes = []
                                    current_boxes_with_class = []
                                    for box in boxes.data:
                                        x1, y1, x2, y2, conf, cls = box.cpu().numpy()
                                        x1 = x1 * orig_w / model_w
                                        x2 = x2 * orig_w / model_w
                                        y1 = y1 * orig_h / model_h
                                        y2 = y2 * orig_h / model_h

                                        if (0 <= x1 < orig_w and 0 <= y1 < orig_h and
                                            0 <= x2 < orig_w and 0 <= y2 < orig_h and
                                            conf >= proc_confidence):
                                            current_boxes.append([x1, y1, x2, y2])
                                            current_boxes_with_class.append((x1, y1, x2, y2, int(cls)))

                                    # Filter detections
                                    filtered_boxes = laser_filter.update_and_filter(current_boxes)
                                    filtered_set = set(tuple(box) for box in filtered_boxes)

                                    # Count by class and save labels
                                    if len(filtered_set) > 0:
                                        yolo_lines = []
                                        for x1, y1, x2, y2, cls_id in current_boxes_with_class:
                                            if (x1, y1, x2, y2) in filtered_set:
                                                class_name = result.names.get(cls_id, f"class_{cls_id}")
                                                detection_counts_by_class[class_name] = detection_counts_by_class.get(class_name, 0) + 1

                                                # YOLO format label
                                                center_x = ((x1 + x2) / 2) / orig_w
                                                center_y = ((y1 + y2) / 2) / orig_h
                                                box_width = (x2 - x1) / orig_w
                                                box_height = (y2 - y1) / orig_h
                                                yolo_lines.append(f"{cls_id} {center_x:.6f} {center_y:.6f} {box_width:.6f} {box_height:.6f}")

                                        total_detection_count += len(filtered_boxes)

                                        # Save YOLO label
                                        if yolo_lines:
                                            label_path = labels_folder / img_path.name.replace('.jpg', '.txt')
                                            with open(label_path, 'w') as f:
                                                f.write('\n'.join(yolo_lines))

                            # Progress update
                            if (i + 1) % 50 == 0 or (i + 1) == total_images:
                                print(f"📁 Post-processing: {i + 1}/{total_images} frames, {total_detection_count} detections")
                                status_pub.send_json({
                                    "post_process_progress": i + 1,
                                    "post_process_total": total_images
                                })

                        except Exception as e:
                            print(f"⚠️ Error processing {img_path.name}: {e}")
                            continue

                    print(f"\n{'='*60}")
                    print(f"✅ POST-PROCESSING COMPLETE")
                    print(f"{'='*60}")
                    print(f"  Images processed: {total_images}")
                    print(f"  Total detections: {total_detection_count}")
                    print(f"  By class: {detection_counts_by_class}")
                    if save_enhanced and run_enhancement:
                        print(f"  Enhanced saved to: {enhanced_folder}")
                    print(f"{'='*60}\n")

                    # Return summary - wait for next recv to send this
                    # Note: This uses a blocking pattern where we expect the GUI to poll
                    control_rep.send_json({
                        "status": "complete",
                        "images_processed": total_images,
                        "enhanced_saved": save_enhanced and run_enhancement,
                        "enhanced_folder": str(enhanced_folder) if save_enhanced and run_enhancement else None,
                        "detections": {
                            "total": total_detection_count,
                            "by_class": detection_counts_by_class.copy()
                        }
                    })

                else:
                    control_rep.send_json({"status": "unknown command"})

            # Process camera frames - buffer for FIFO processing (normal mode)
            # In fast_recording_mode, this buffer isn't used - frames go directly to disk

            # Receive all available frames into buffer (non-blocking)
            while camera_sub.poll(0):
                try:
                    incoming_msg = camera_sub.recv(zmq.NOBLOCK)
                    if len(incoming_msg) >= 18:
                        frame_buffer.append(incoming_msg)
                except zmq.Again:
                    break

            # Check RAM periodically and drop frames if critical
            ram_check_counter += 1
            if ram_check_counter >= RAM_CHECK_INTERVAL:
                ram_check_counter = 0
                if check_ram_critical():
                    # Drop oldest half of buffer to free memory
                    drop_count = len(frame_buffer) // 2
                    for _ in range(drop_count):
                        if frame_buffer:
                            frame_buffer.popleft()
                            frames_dropped_ram += 1
                    if drop_count > 0:
                        mem = psutil.virtual_memory()
                        print(f"⚠️  RAM CRITICAL ({mem.percent:.1f}%): Dropped {drop_count} frames, buffer now {len(frame_buffer)}")

            # Get next frame from buffer (FIFO - oldest first)
            if frame_buffer:
                msg = frame_buffer.popleft()
            elif camera_sub.poll(10):  # 10ms timeout if buffer empty
                msg = camera_sub.recv()
                if len(msg) < 18:
                    continue
            else:
                continue

            # Parse message: timestamp(8) + frame_id(4) + [h,w,c](6) + image
            if len(msg) < 18:
                continue

            timestamp, frame_id = struct.unpack("dI", msg[:12])
            height, width, channels = np.frombuffer(msg[12:18], dtype=np.uint16)
            payload = msg[18:]

            # Note: Lag-based dropping removed - now using RAM-based dropping only
            # Frames are processed FIFO regardless of age

            # Parse frame (make writable copy for PyTorch)
            if channels == 1:
                frame = np.frombuffer(payload, dtype=np.uint8).reshape((height, width)).copy()
            elif channels == 3:
                frame = np.frombuffer(payload, dtype=np.uint8).reshape((height, width, 3)).copy()
                # Convert to grayscale for holography
                frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            else:
                continue

            # Fast recording mode: skip all processing, just save frames at max speed
            if recording and fast_recording_mode:
                with recording_lock:
                    if recording and recording_frame_counter < recording_target_count:
                        current_time = time.time()
                        timestamp_str = datetime.fromtimestamp(current_time).strftime("%Y%m%d_%H%M%S_%f")
                        filename = f"frame_{recording_frame_counter:06d}_{timestamp_str}.jpg"
                        filepath = str(Path(recording_folder) / filename)

                        thread_id = recording_frame_counter % NUM_WRITER_THREADS
                        try:
                            writer_queues[thread_id].put_nowait((frame.copy(), filepath))
                            metadata_queue.put_nowait((recording_frame_counter, current_time, timestamp_str, filename))
                            recording_frame_counter += 1

                            if recording_frame_counter % 100 == 0:
                                print(f"⚡ Fast recording: {recording_frame_counter}/{recording_target_count}")

                            # Auto-stop when target reached
                            if recording_frame_counter >= recording_target_count:
                                recording = False
                                fast_recording_mode = False
                                # Note: CONFLATE stays at 0 for buffered FIFO mode
                                elapsed = time.time() - recording_start_time
                                print(f"\n{'='*60}")
                                print(f"✅ FAST RECORDING COMPLETE")
                                print(f"{'='*60}")
                                print(f"  Frames: {recording_frame_counter}")
                                print(f"  Time: {elapsed:.2f}s")
                                print(f"  FPS: {recording_frame_counter/elapsed:.1f}")
                                print(f"{'='*60}\n")
                                stop_recording_threads()

                        except queue.Full:
                            print(f"⚠️ Fast recording: queue {thread_id} full, frame dropped")

                # Send raw grayscale frame to display
                meta_header = struct.pack("dI", time.time(), frame_count)
                meta = np.array([height, width, 1], dtype=np.uint16).tobytes()
                processed_pub.send(meta_header + meta + frame.tobytes())
                frame_count += 1
                continue  # Skip normal processing

            # Profiling: start timing
            if profiling_enabled and recording:
                torch.cuda.synchronize()
                t_loop_start = time.time()

            # Convert to tensor (float, range [0, 1]) using pre-allocated buffer
            global gpu_input_buffer
            frame_shape = frame.shape
            if gpu_input_buffer is None or gpu_input_buffer.shape != frame_shape:
                gpu_input_buffer = torch.empty(frame_shape, dtype=torch.float32, device='cuda')
            gpu_input_buffer.copy_(torch.from_numpy(frame), non_blocking=True)
            gpu_input_buffer.mul_(1.0 / 255.0)  # in-place normalize (mul faster than div)
            tensor_img = gpu_input_buffer

            if profiling_enabled and recording:
                torch.cuda.synchronize()
                t_to_gpu = time.time()

            # Reset frame_raw each iteration to prevent stale data when detection is off
            frame_raw = None

            # Apply enhancement if enabled
            if enhancement_enabled:
                tensor_shape = tensor_img.shape
                if enhancer is None or current_shape != tensor_shape:
                    enhancer = MovingWindowEnhancer(window_size=20)
                    current_shape = tensor_shape
                    print(f"🔧 Initialized enhancer for shape {tensor_shape}")

                # Enhance frame (returns float [0,1] directly to avoid uint8 round-trip)
                tensor_img = enhancer.enhance(tensor_img, return_float=True)

            if profiling_enabled and recording:
                torch.cuda.synchronize()
                t_enhance = time.time()

            # Initialize profiling variables for all stages
            t_prefilter = t_model_prep = t_inference = t_postprocess = None
            t_to_cpu = t_status = t_queue = None

            # Run detection if enabled
            if detection_enabled and model is not None:
                t_start = time.time()

                # Clear detection variables at start of each frame to prevent stale data
                filtered_set = set()
                current_boxes_with_class = []
                frame_raw = None  # Will hold raw frame without boxes for recording

                # Prefilter check - skip expensive processing if no particles detected
                if prefilter_enabled and prefilter_model is not None:
                    # TinyCNN BackgroundFilter takes grayscale directly at native resolution
                    # tensor_img is (H, W) float [0, 1] on GPU
                    particles_prob = prefilter_model.get_probability(tensor_img)

                    # Debug: log probability periodically
                    if frame_count % 100 == 0:
                        print(f"  🔬 Prefilter prob: {particles_prob:.4f} | Threshold: {prefilter_threshold}")

                    if particles_prob < prefilter_threshold:
                        # No particles - skip reconstruction and detection
                        prefilter_skip_count += 1

                        if not performance_mode and frame_count % 100 == 0:
                            pass_rate = prefilter_pass_count / (prefilter_pass_count + prefilter_skip_count) * 100 if (prefilter_pass_count + prefilter_skip_count) > 0 else 0
                            print(f"  ⏭️ Prefilter: skipped (prob={particles_prob:.4f} < {prefilter_threshold}) | Pass rate: {pass_rate:.1f}%")

                        # Send the frame without detection, publish status with pipeline FPS
                        frame_uint8 = (tensor_img * 255).clamp(0, 255).to(torch.uint8).cpu().numpy()
                        send_frame = frame_uint8

                        # Calculate pipeline FPS for prefilter-only path
                        total_time = time.time() - t_start
                        pipeline_times.append(total_time)
                        if len(pipeline_times) > PIPELINE_FPS_WINDOW:
                            pipeline_times.pop(0)
                        avg_time = sum(pipeline_times) / len(pipeline_times)
                        pipeline_fps = 1.0 / avg_time if avg_time > 0 else 0.0

                        status_pub.send_json({"particle_count": total_particle_count, "pipeline_fps": pipeline_fps})

                        # Handle recording even when prefilter skips detection
                        if recording and recording_frame_counter < recording_target_count:
                            current_time = time.time()
                            timestamp_str = datetime.fromtimestamp(current_time).strftime("%Y%m%d_%H%M%S_%f")
                            filename = f"frame_{recording_frame_counter:06d}_{timestamp_str}.jpg"
                            filepath = str(Path(recording_folder) / filename)

                            should_save = (save_start <= recording_frame_counter < save_end)
                            if should_save:
                                thread_id = saved_frame_counter % NUM_WRITER_THREADS
                                try:
                                    writer_queues[thread_id].put_nowait((send_frame.copy(), filepath))
                                    metadata_queue.put_nowait((recording_frame_counter, current_time, timestamp_str, filename))
                                    saved_frame_counter += 1
                                except queue.Full:
                                    print(f"⚠️ Prefilter recording: queue full, frame dropped")

                            recording_frame_counter += 1

                            # Publish progress
                            if recording_frame_counter % 10 == 0:
                                status_pub.send_json({
                                    "recording_progress": recording_frame_counter,
                                    "recording_target": recording_target_count,
                                    "frames_saved": saved_frame_counter
                                })

                            # Check for auto-stop
                            if recording_frame_counter >= recording_target_count:
                                recording = False
                                elapsed_time = time.time() - recording_start_time
                                print(f"\n{'='*60}")
                                print(f"✅ RECORDING TARGET REACHED (prefilter path)")
                                print(f"{'='*60}")
                                print(f"  Frames processed: {recording_frame_counter}")
                                print(f"  Frames saved: {saved_frame_counter}")
                                print(f"{'='*60}\n")
                                stop_recording_threads()
                                status_pub.send_json({
                                    "recording_complete": True,
                                    "frames_processed": recording_frame_counter,
                                    "frames_saved": saved_frame_counter,
                                    "save_percentage": save_percentage,
                                    "elapsed_time": elapsed_time,
                                    "folder": recording_folder
                                })

                        # Skip to frame sending (jump past detection block)
                        # We need to handle frame sending here since we're skipping the detection
                        height, width = send_frame.shape[:2]
                        channels = send_frame.shape[2] if len(send_frame.shape) > 2 else 1
                        meta_header = struct.pack("dI", time.time(), frame_count)
                        meta = np.array([height, width, channels], dtype=np.uint16).tobytes()
                        processed_pub.send(meta_header + meta + send_frame.tobytes())
                        frame_count += 1
                        continue  # Skip to next frame

                    else:
                        # Particles detected - continue with full pipeline
                        prefilter_pass_count += 1
                        if not performance_mode and frame_count % 100 == 0:
                            pass_rate = prefilter_pass_count / (prefilter_pass_count + prefilter_skip_count) * 100 if (prefilter_pass_count + prefilter_skip_count) > 0 else 0
                            print(f"  ✅ Prefilter: passed (prob={particles_prob:.4f} >= {prefilter_threshold}) | Pass rate: {pass_rate:.1f}%")

                    if profiling_enabled and recording:
                        torch.cuda.synchronize()
                        t_prefilter = time.time()

                # Prepare for YOLO: convert grayscale to 3-channel (matching manual detection)
                # tensor_img is (H, W) float [0, 1]
                img_h, img_w = tensor_img.shape

                # Stack grayscale to 3 channels: (H, W) -> (1, 3, H, W)
                model_in = tensor_img.unsqueeze(0).unsqueeze(0)  # (1, 1, H, W)
                model_in = model_in.expand(-1, 3, -1, -1)  # (1, 3, H, W)

                # Resize to model input size
                try:
                    model_input_size = model.model.args.get("imgsz", 640)
                except (AttributeError, TypeError):
                    model_input_size = 640  # Default for TensorRT
                if isinstance(model_input_size, int):
                    model_input_size = (model_input_size, model_input_size)

                model_in = F.interpolate(
                    model_in,
                    size=model_input_size,
                    mode="bilinear",
                    align_corners=False
                )

                if profiling_enabled and recording:
                    torch.cuda.synchronize()
                    t_model_prep = time.time()

                # Run inference
                with torch.no_grad():
                    # Warmup model on first detection
                    if not model_warmed_up:
                        print(f"\n{'='*60}")
                        print(f"⚙️  WARMUP PHASE - First Detection")
                        print(f"{'='*60}")
                        print(f"  Model input shape: {model_in.shape}")
                        print(f"  Device: {model_in.device}")
                        print(f"  Dtype: {model_in.dtype}")
                        print(f"\n  Running first inference (may take 10-20 seconds)...")
                        print(f"  This initializes CUDA kernels and allocates GPU memory.")
                        print(f"  The GUI will freeze temporarily - this is normal!")

                        t_warmup = time.time()
                        _ = model(model_in, conf=confidence_threshold, verbose=False, device="cuda")
                        warmup_time = time.time() - t_warmup

                        model_warmed_up = True

                        # Flush stale frames
                        flushed = 0
                        while camera_sub.poll(0):
                            _ = camera_sub.recv(zmq.NOBLOCK)
                            flushed += 1

                        print(f"\n✅ WARMUP COMPLETE!")
                        print(f"  Warmup took: {warmup_time:.2f}s")
                        print(f"  Flushed {flushed} stale frames from buffer")
                        print(f"  Next frames will be processed at full speed (~10ms/frame)")
                        print(f"{'='*60}\n")

                        # If recording, we need to count this frame even though we skip detection
                        if recording and recording_frame_counter < recording_target_count:
                            # Create basic grayscale frame for recording (no detection boxes)
                            frame_uint8 = (tensor_img * 255).clamp(0, 255).to(torch.uint8).cpu().numpy()
                            send_frame = frame_uint8

                            # Use the recording block logic inline
                            current_time = time.time()
                            timestamp_str = datetime.fromtimestamp(current_time).strftime("%Y%m%d_%H%M%S_%f")
                            filename = f"frame_{recording_frame_counter:06d}_{timestamp_str}.jpg"
                            filepath = str(Path(recording_folder) / filename)

                            should_save = (save_start <= recording_frame_counter < save_end)
                            if should_save:
                                thread_id = saved_frame_counter % NUM_WRITER_THREADS
                                try:
                                    writer_queues[thread_id].put_nowait((send_frame.copy(), filepath))
                                    metadata_queue.put_nowait((recording_frame_counter, current_time, timestamp_str, filename))
                                    saved_frame_counter += 1
                                except queue.Full:
                                    print(f"⚠️ Warmup recording: queue full, frame dropped")

                            recording_frame_counter += 1

                            # Publish progress
                            if recording_frame_counter % 10 == 0:
                                status_pub.send_json({
                                    "recording_progress": recording_frame_counter,
                                    "recording_target": recording_target_count,
                                    "frames_saved": saved_frame_counter
                                })

                        continue  # Skip rest of detection processing for warmup frame

                    # Real inference (TensorRT handles FP16 internally)
                    t_infer = time.time()
                    if using_tensorrt:
                        result = model(model_in, conf=confidence_threshold, verbose=False)[0]
                    else:
                        # Use half precision for faster inference with PyTorch model
                        model_in_fp16 = model_in.half()
                        result = model(model_in_fp16, conf=confidence_threshold, verbose=False, device="cuda", half=True)[0]
                    t_infer_elapsed = time.time() - t_infer

                    if not performance_mode and frame_count % 30 == 0:
                        print(f"  🎯 YOLO inference took: {t_infer_elapsed*1000:.1f}ms")

                    if profiling_enabled and recording:
                        torch.cuda.synchronize()
                        t_inference = time.time()

                # Convert tensor to BGR image for drawing boxes
                frame_bgr = (tensor_img * 255).clamp(0, 255).to(torch.uint8).cpu().numpy()
                frame_bgr = cv2.cvtColor(frame_bgr, cv2.COLOR_GRAY2BGR)

                # Keep a copy without boxes for recording (Full Test saves raw frames)
                frame_raw = frame_bgr.copy()

                # Extract and filter detections
                boxes = result.boxes
                if boxes is not None and boxes.data.numel() > 0:
                    orig_h, orig_w = frame_bgr.shape[:2]
                    model_h, model_w = model_input_size

                    # Extract boxes and scale to original size (with class info)
                    current_boxes = []
                    current_boxes_with_class = []  # [(x1, y1, x2, y2, class_id), ...]
                    for box in boxes.data:
                        x1, y1, x2, y2, conf, cls = box.cpu().numpy()

                        # Scale from model size to original size
                        x1 = x1 * orig_w / model_w
                        x2 = x2 * orig_w / model_w
                        y1 = y1 * orig_h / model_h
                        y2 = y2 * orig_h / model_h

                        # Validate coordinates
                        if (0 <= x1 < orig_w and 0 <= y1 < orig_h and
                            0 <= x2 < orig_w and 0 <= y2 < orig_h and
                            conf >= confidence_threshold):
                            current_boxes.append([x1, y1, x2, y2])
                            current_boxes_with_class.append((x1, y1, x2, y2, int(cls)))

                    # Filter out laser spots
                    t_filter = time.time()
                    filtered_boxes = laser_filter.update_and_filter(current_boxes)
                    t_filter_elapsed = time.time() - t_filter

                    # Find which boxes passed the filter (by matching coordinates)
                    filtered_set = set(tuple(box) for box in filtered_boxes)

                    # Draw filtered boxes and count by class
                    frame_class_counts = {}  # class_name -> count for this frame
                    for x1, y1, x2, y2, cls_id in current_boxes_with_class:
                        if (x1, y1, x2, y2) in filtered_set:
                            # Get class name from model
                            class_name = result.names.get(cls_id, f"class_{cls_id}")

                            # Count by class for Full Test summary
                            detection_counts_by_class[class_name] = detection_counts_by_class.get(class_name, 0) + 1
                            frame_class_counts[class_name] = frame_class_counts.get(class_name, 0) + 1

                            cv2.rectangle(
                                frame_bgr,
                                (int(x1), int(y1)),
                                (int(x2), int(y2)),
                                (0, 255, 0),  # Green boxes
                                2
                            )
                            cv2.putText(
                                frame_bgr,
                                class_name,
                                (int(x1), int(y1) - 10),
                                cv2.FONT_HERSHEY_SIMPLEX,
                                0.5,
                                (0, 255, 0),
                                1
                            )

                    # Add to cumulative totals
                    total_particle_count += len(filtered_boxes)
                    total_detection_count += len(filtered_boxes)

                    # Calculate pipeline FPS (rolling average)
                    total_time = time.time() - t_start
                    pipeline_times.append(total_time)
                    if len(pipeline_times) > PIPELINE_FPS_WINDOW:
                        pipeline_times.pop(0)
                    avg_time = sum(pipeline_times) / len(pipeline_times)
                    pipeline_fps = 1.0 / avg_time if avg_time > 0 else 0.0

                    # Publish cumulative detection count and pipeline FPS
                    status_pub.send_json({"particle_count": total_particle_count, "pipeline_fps": pipeline_fps})

                    # Log detection count (only when performance_mode is off)
                    if not performance_mode and frame_count % 30 == 0:  # Every 30 frames
                        drop_rate = (dropped_frames / (frame_count + dropped_frames) * 100) if (frame_count + dropped_frames) > 0 else 0
                        mem = psutil.virtual_memory()
                        print(f"  🎯 Detections: {len(current_boxes)} → {len(filtered_boxes)} (filtered) | Total: {total_particle_count}")
                        print(f"  🚀 Pipeline: {total_time*1000:.1f}ms ({pipeline_fps:.1f} FPS) | Dropped frames: {dropped_frames} ({drop_rate:.1f}%)")
                        print(f"  📊 Buffer: {len(frame_buffer)} frames | RAM: {mem.percent:.1f}% | Dropped (RAM): {frames_dropped_ram}")
                else:
                    # No detections this frame, but still publish cumulative total
                    # Calculate pipeline FPS (rolling average)
                    total_time = time.time() - t_start
                    pipeline_times.append(total_time)
                    if len(pipeline_times) > PIPELINE_FPS_WINDOW:
                        pipeline_times.pop(0)
                    avg_time = sum(pipeline_times) / len(pipeline_times)
                    pipeline_fps = 1.0 / avg_time if avg_time > 0 else 0.0

                    status_pub.send_json({"particle_count": total_particle_count, "pipeline_fps": pipeline_fps})

                    if not performance_mode and frame_count % 30 == 0:
                        print(f"  ℹ️  No detections above threshold {confidence_threshold}")

                if profiling_enabled and recording:
                    t_postprocess = time.time()

                # Use BGR frame with boxes
                send_frame = frame_bgr

            else:
                # No detection: send grayscale or enhanced frame
                frame_uint8 = (tensor_img * 255).clamp(0, 255).to(torch.uint8).cpu().numpy()
                send_frame = frame_uint8

                if profiling_enabled and recording:
                    t_to_cpu = time.time()

                # Publish total count (will be 0 if detection never enabled)
                # pipeline_fps is 0 when detection is off
                status_pub.send_json({"particle_count": total_particle_count, "pipeline_fps": 0.0})

                if profiling_enabled and recording:
                    t_status = time.time()

            # Save frame if recording is enabled
            if recording and recording_frame_counter < recording_target_count:
                try:
                    # Generate timestamp with microsecond precision
                    current_time = time.time()
                    timestamp_str = datetime.fromtimestamp(current_time).strftime("%Y%m%d_%H%M%S_%f")

                    # Create filename: frame_NNNNNN_timestamp.jpg
                    filename = f"frame_{recording_frame_counter:06d}_{timestamp_str}.jpg"
                    filepath = str(Path(recording_folder) / filename)

                    # Check if this frame is within the save window (first batch)
                    should_save = (save_start <= recording_frame_counter < save_end)

                    # Try to queue the frame (non-blocking) if within save window
                    try:
                        if should_save:
                            # Round-robin distribute frames to writer threads
                            thread_id = saved_frame_counter % NUM_WRITER_THREADS
                            writer_queue = writer_queues[thread_id]

                            # Save raw frame without bounding boxes (use frame_raw if available)
                            save_frame = frame_raw if frame_raw is not None else send_frame
                            writer_queue.put_nowait((save_frame.copy(), filepath))

                            if profiling_enabled:
                                t_queue = time.time()

                            # Queue metadata for CSV
                            metadata_queue.put_nowait((
                                recording_frame_counter,
                                current_time,
                                timestamp_str,
                                filename
                            ))

                            # Save YOLO format labels if detection is enabled and we have detections
                            if detection_enabled and len(filtered_set) > 0:
                                try:
                                    labels_folder = Path(recording_folder).parent / "labels"
                                    label_filename = filename.replace('.jpg', '.txt')
                                    label_filepath = labels_folder / label_filename

                                    orig_h, orig_w = send_frame.shape[:2]
                                    yolo_lines = []

                                    for x1, y1, x2, y2, cls_id in current_boxes_with_class:
                                        if (x1, y1, x2, y2) in filtered_set:
                                            # YOLO format: class_id center_x center_y width height (all normalized 0-1)
                                            center_x = ((x1 + x2) / 2) / orig_w
                                            center_y = ((y1 + y2) / 2) / orig_h
                                            box_width = (x2 - x1) / orig_w
                                            box_height = (y2 - y1) / orig_h
                                            yolo_lines.append(f"{cls_id} {center_x:.6f} {center_y:.6f} {box_width:.6f} {box_height:.6f}")

                                    if yolo_lines:
                                        with open(label_filepath, 'w') as f:
                                            f.write('\n'.join(yolo_lines))
                                except Exception as label_err:
                                    print(f"⚠️ Failed to save label: {label_err}")

                            saved_frame_counter += 1

                        # Always increment frame counter (for progress tracking)
                        recording_frame_counter += 1

                        # Publish progress to GUI every 10 frames
                        if recording_frame_counter % 10 == 0 or recording_frame_counter == recording_target_count:
                            status_pub.send_json({
                                "recording_progress": recording_frame_counter,
                                "recording_target": recording_target_count,
                                "frames_saved": saved_frame_counter
                            })

                        # Log progress (include save info when within save window)
                        if recording_frame_counter % 50 == 0 or recording_frame_counter == recording_target_count:
                            if save_percentage < 1.0:
                                print(f"📹 Recording: {recording_frame_counter}/{recording_target_count} frames processed, {saved_frame_counter} saved")
                            else:
                                print(f"📹 Recording: {recording_frame_counter}/{recording_target_count} frames queued")

                        # Auto-stop when target reached
                        if recording_frame_counter >= recording_target_count:
                            recording = False
                            elapsed_time = time.time() - recording_start_time
                            print(f"\n{'='*60}")
                            print(f"✅ RECORDING TARGET REACHED")
                            print(f"{'='*60}")
                            print(f"  Frames processed: {recording_frame_counter}")
                            print(f"  Frames saved: {saved_frame_counter}")
                            if save_percentage < 1.0:
                                print(f"  Save window: {save_start}-{save_end-1} ({save_percentage*100:.0f}%)")
                            print(f"  Elapsed time: {elapsed_time:.2f}s")
                            print(f"  Average FPS: {recording_frame_counter/elapsed_time:.1f}")
                            print(f"  Writer threads finishing writes...")
                            print(f"{'='*60}\n")

                            # Save profiling data to CSV if enabled
                            if profiling_enabled and profiling_data:
                                import csv
                                profiling_csv_path = Path(recording_folder).parent / "profiling_data.csv"
                                fieldnames = ['frame', 'to_gpu_ms', 'enhance_ms', 'prefilter_ms', 'model_prep_ms', 'inference_ms', 'postprocess_ms', 'to_cpu_ms', 'status_ms', 'queue_ms', 'zmq_send_ms', 'total_ms']
                                with open(profiling_csv_path, 'w', newline='') as f:
                                    writer = csv.DictWriter(f, fieldnames=fieldnames)
                                    writer.writeheader()
                                    writer.writerows(profiling_data)

                                    # Add blank row then summary statistics
                                    f.write('\n')
                                    f.write('stage,average_ms\n')
                                    timing_fields = [fn for fn in fieldnames if fn != 'frame']
                                    for field in timing_fields:
                                        values = [row[field] for row in profiling_data if field in row]
                                        avg = sum(values) / len(values) if values else 0
                                        f.write(f'{field},{avg:.6f}\n')

                                print(f"📊 Profiling data saved to {profiling_csv_path}")
                                profiling_data.clear()

                            # Stop writer threads after they finish
                            stop_recording_threads()

                            # Notify GUI that recording is complete
                            status_pub.send_json({
                                "recording_complete": True,
                                "frames_processed": recording_frame_counter,
                                "frames_saved": saved_frame_counter,
                                "save_percentage": save_percentage,
                                "elapsed_time": elapsed_time,
                                "folder": recording_folder
                            })

                    except queue.Full:
                        print(f"⚠️ Recording queue {thread_id} full - frame dropped")

                except Exception as e:
                    print(f"❌ Recording error: {e}")

            # Send processed frame
            height, width = send_frame.shape[:2]
            channels = send_frame.shape[2] if send_frame.ndim == 3 else 1

            meta_header = struct.pack("dI", time.time(), frame_count)
            meta = np.array([height, width, channels], dtype=np.uint16).tobytes()
            payload = send_frame.astype(np.uint8).tobytes()

            processed_pub.send(meta_header + meta + payload)
            frame_count += 1

            # Profiling: collect timing data
            if profiling_enabled and recording:
                t_zmq_send = time.time()
                if t_queue and t_status:
                    queue_ms = (t_queue - t_status) * 1000
                    zmq_base = t_queue
                else:
                    queue_ms = 0
                    zmq_base = t_status if t_status else t_postprocess if t_postprocess else t_enhance

                # Calculate timing for each stage
                enhance_base = t_to_gpu
                if detection_enabled:
                    # Detection path timing
                    prefilter_ms = (t_prefilter - t_enhance) * 1000 if t_prefilter else 0
                    model_prep_base = t_prefilter if t_prefilter else t_enhance
                    model_prep_ms = (t_model_prep - model_prep_base) * 1000 if t_model_prep else 0
                    inference_ms = (t_inference - t_model_prep) * 1000 if t_inference and t_model_prep else 0
                    postprocess_ms = (t_postprocess - t_inference) * 1000 if t_postprocess and t_inference else 0
                    to_cpu_ms = 0  # CPU transfer is included in postprocess for detection path
                    status_ms = 0  # Status send is included in postprocess for detection path
                else:
                    # Non-detection path timing
                    prefilter_ms = 0
                    model_prep_ms = 0
                    inference_ms = 0
                    postprocess_ms = 0
                    to_cpu_ms = (t_to_cpu - t_enhance) * 1000 if enhancement_enabled else (t_to_cpu - t_to_gpu) * 1000
                    status_ms = (t_status - t_to_cpu) * 1000

                profiling_data.append({
                    'frame': recording_frame_counter - 1,
                    'to_gpu_ms': (t_to_gpu - t_loop_start) * 1000,
                    'enhance_ms': (t_enhance - t_to_gpu) * 1000 if enhancement_enabled else 0,
                    'prefilter_ms': prefilter_ms,
                    'model_prep_ms': model_prep_ms,
                    'inference_ms': inference_ms,
                    'postprocess_ms': postprocess_ms,
                    'to_cpu_ms': to_cpu_ms,
                    'status_ms': status_ms,
                    'queue_ms': queue_ms,
                    'zmq_send_ms': (t_zmq_send - zmq_base) * 1000,
                    'total_ms': (t_zmq_send - t_loop_start) * 1000,
                })

            # Debug output (less frequent in performance mode)
            log_interval = 5000 if performance_mode else 1000
            if frame_count % log_interval == 0:
                fps_estimate = 1000 / (time.time() - timestamp + 0.001)
                drop_rate = (dropped_frames / (frame_count + dropped_frames) * 100) if (frame_count + dropped_frames) > 0 else 0
                print(f"📊 Processed: {frame_count} frames | Dropped: {dropped_frames} ({drop_rate:.1f}%) | Est. {fps_estimate:.1f} FPS")

        except KeyboardInterrupt:
            print("\n👋 Shutting down...")
            break
        except Exception as e:
            print(f"\n{'='*60}")
            print(f"❌ FATAL ERROR IN MAIN LOOP")
            print(f"{'='*60}")
            print(f"Error: {e}")
            print(f"\nFull traceback:")
            import traceback
            traceback.print_exc()
            print(f"\n{'='*60}")
            print(f"⏸️  PAUSED - Press Ctrl+C to exit or wait 10 seconds to retry...")
            print(f"{'='*60}")
            time.sleep(10)  # Pause so you can read the error


if __name__ == "__main__":
    main()

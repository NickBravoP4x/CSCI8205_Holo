class TRTClassifier:
    """Direct TensorRT inference for classifier - bypasses ultralytics overhead.

    Achieves ~1000 FPS vs ~127 FPS through ultralytics wrapper.
    """

    def __init__(self, engine_path: str, device: int = 0):
        """Load TensorRT engine and allocate buffers.

        Args:
            engine_path: Path to .engine file
            device: CUDA device index
        """
        if not TENSORRT_AVAILABLE:
            raise RuntimeError("TensorRT not available")

        self.device = device
        self.stream = torch.cuda.Stream(device=device)

        # Load engine
        self.logger = trt.Logger(trt.Logger.WARNING)
        with open(engine_path, 'rb') as f:
            engine_data = f.read()

        self.runtime = trt.Runtime(self.logger)
        self.engine = self.runtime.deserialize_cuda_engine(engine_data)
        self.context = self.engine.create_execution_context()

        # Get input/output info
        self.input_name = self.engine.get_tensor_name(0)
        self.output_name = self.engine.get_tensor_name(1)

        input_shape = self.engine.get_tensor_shape(self.input_name)
        output_shape = self.engine.get_tensor_shape(self.output_name)

        # Handle dynamic batch dimension (-1)
        if input_shape[0] == -1:
            input_shape = (1,) + tuple(input_shape[1:])
        if output_shape[0] == -1:
            output_shape = (1,) + tuple(output_shape[1:])

        self.input_shape = tuple(input_shape)
        self.output_shape = tuple(output_shape)

        # Pre-allocate GPU buffers
        self.input_buffer = torch.zeros(self.input_shape, dtype=torch.float16, device=f'cuda:{device}')
        self.output_buffer = torch.zeros(self.output_shape, dtype=torch.float16, device=f'cuda:{device}')

        # Set tensor addresses
        self.context.set_tensor_address(self.input_name, self.input_buffer.data_ptr())
        self.context.set_tensor_address(self.output_name, self.output_buffer.data_ptr())

        print(f"  TRTClassifier loaded: input={self.input_shape}, output={self.output_shape}")

    def __call__(self, x: torch.Tensor) -> torch.Tensor:
        """Run inference on input tensor.

        Args:
            x: Input tensor of shape (1, 3, H, W), float16, on GPU

        Returns:
            Class probabilities tensor of shape (num_classes,)
        """
        # Copy input (handles size mismatch via resize if needed)
        if x.shape != self.input_shape:
            x = F.interpolate(x, size=self.input_shape[2:], mode='bilinear', align_corners=False)

        self.input_buffer.copy_(x)

        # Run inference
        self.context.execute_async_v3(self.stream.cuda_stream)
        self.stream.synchronize()

        # Softmax to get probabilities
        raw_out = self.output_buffer.float().squeeze()
        probs = torch.softmax(raw_out, dim=-1)

        # Debug: log raw output periodically
        if not hasattr(self, '_debug_count'):
            self._debug_count = 0
        self._debug_count += 1
        if self._debug_count % 100 == 1:  # First call and every 100 calls
            print(f"  🔧 TRTClassifier: raw={raw_out.tolist()} -> softmax={probs.tolist()}")

        return probs

    def warmup(self, n: int = 10):
        """Warmup the engine with dummy data."""
        dummy = torch.rand(self.input_shape, dtype=torch.float16, device=self.input_buffer.device)
        for _ in range(n):
            _ = self(dummy)
        print(f"  TRTClassifier warmed up ({n} iterations)")


